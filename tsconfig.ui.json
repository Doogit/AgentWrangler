{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "src/ui/**/*",
    "test/ui/**/*",
    "src/query/envelope.ts",
    "src/query/api/overview.ts",
    "src/query/api/settings.ts",
    "src/query/api/hook-config.ts",
    "src/query/api/idle-sessions.ts",
    "src/query/api/trends.ts"
  ],
  "exclude": ["node_modules"]
}

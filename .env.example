# AgentWrangler configuration (all optional; sensible defaults apply)
# HTTP port for the local daemon (default 2929)
AW_PORT=2929
# Path to the SQLite database (default ~/.agentwrangler/db.sqlite)
AW_DB_PATH=
# Root directory scanned for Claude Code transcripts (default ~/.claude/projects)
AW_SCAN_ROOT=
# Activity window in seconds for determining live sessions (default 300)
AW_ACTIVITY_WINDOW_SECS=
# Directory the built UI is served from (default <repo>/dist/ui)
AW_UI_ROOT=
# Read-only GitHub PAT for optional outcomes sync (requires gh on PATH; overrides Windows Credential Manager)
AW_GITHUB_TOKEN=
# Set to 1 to suppress auto-opening the browser on daemon start
AW_NO_OPEN=
# Directory for hook context-budget marker files (default ~/.agentwrangler/hook-markers)
AW_HOOK_MARKER_DIR=
# Directory for PreCompact raw transcript copies (default ~/.agentwrangler/checkpoints)
AW_CHECKPOINT_DIR=
# Set to off to disable the claude /usage reader (default on)
AW_USAGE_CLI=
